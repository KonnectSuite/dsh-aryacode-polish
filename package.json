{
  "name": "@aryacode/dsh-aryacode-polish",
  "version": "0.117.0",
  "description": "AryaCode Polish: one install for the small things that make AryaCode feel finished. One Plugins row, one switch per quality-of-life feature.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "polish",
    "quality-of-life",
    "cost",
    "usage"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnectSuite/dsh-aryacode-polish.git"
  },
  "homepage": "https://github.com/KonnectSuite/dsh-aryacode-polish#readme",
  "bugs": {
    "url": "https://github.com/KonnectSuite/dsh-aryacode-polish/issues"
  },
  "files": [
    "cordis.patch.yml",
    "entries/**/*",
    "client/**/*",
    "lib/**/*",
    "locale/*.json",
    "docs/**/*",
    "presets/**/*",
    "skills/**/*",
    "mcp/**/*",
    "web/**/*",
    "vendor/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": "^0.2.1-rc.3 || ^0.2.2-alpha.2"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "test": "node --test test/patch.spec.mjs test/config.spec.mjs test/registry.spec.mjs test/cost.spec.mjs test/money.spec.mjs test/account.spec.mjs test/github.spec.mjs test/workspace.spec.mjs test/sessions.spec.mjs test/folders.spec.mjs test/trash.spec.mjs test/docs.spec.mjs test/manifests.spec.mjs test/client-face.spec.mjs test/preview.spec.mjs test/vendor.spec.mjs test/arya-standard.spec.mjs test/arya-standard-compaction.spec.mjs test/arya-standard-triggers.spec.mjs test/memory.spec.mjs test/hooks.spec.mjs test/arya-qwen.spec.mjs test/arya-claude.spec.mjs test/arya-claude-compaction.spec.mjs test/review-skills.spec.mjs test/arya-standard-ui.spec.mjs test/mcp-store.spec.mjs test/mcp-catalog.spec.mjs test/mcp-host.spec.mjs test/mcp-ui.spec.mjs test/aryasearch.spec.mjs test/aryasearch-ui.spec.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-compaction": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-mcp-client": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.3 || ^0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "html2canvas": "1.4.1",
    "js-yaml": "^4.1.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./polish": "./entries/polish.js",
    "./arya-standard": "./presets/arya-standard/engine.js",
    "./arya-standard-policy": "./presets/arya-standard/policy.js",
    "./arya-qwen": "./presets/arya-qwen/engine.js",
    "./arya-qwen-policy": "./presets/arya-qwen/policy.js",
    "./arya-claude": "./presets/arya-claude/engine.js",
    "./arya-claude-policy": "./presets/arya-claude/policy.js",
    "./arya-claude-pruner": "./presets/arya-claude/pruner.js",
    "./mcp": "./entries/mcp.js"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  }
}
