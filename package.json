{
  "name": "@aryacode/dsh-aryacode-polish",
  "version": "0.38.0",
  "description": "AryaCode Polish: one install for the small things that make AryaCode feel finished. One Plugins row, one switch per quality-of-life feature.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "polish",
    "quality-of-life",
    "cost",
    "usage"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnectSuite/dsh-aryacode-polish.git"
  },
  "homepage": "https://github.com/KonnectSuite/dsh-aryacode-polish#readme",
  "bugs": {
    "url": "https://github.com/KonnectSuite/dsh-aryacode-polish/issues"
  },
  "files": [
    "cordis.patch.yml",
    "entries/**/*",
    "client/**/*",
    "lib/**/*",
    "locale/*.json",
    "docs/**/*",
    "vendor/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "engines": {
      "dsh": "^0.2.1-rc.3"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "prepack": "node scripts/build-client.mjs",
    "test": "node --test test/patch.spec.mjs test/config.spec.mjs test/registry.spec.mjs test/cost.spec.mjs test/money.spec.mjs test/account.spec.mjs test/github.spec.mjs test/workspace.spec.mjs test/folders.spec.mjs test/docs.spec.mjs test/manifests.spec.mjs test/client-face.spec.mjs test/vendor.spec.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "html2canvas": "1.4.1",
    "js-yaml": "^4.1.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./polish": "./entries/polish.js"
  }
}
