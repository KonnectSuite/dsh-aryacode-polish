{
  "name": "@aryacode/dsh-aryacode-polish",
  "version": "0.1.0",
  "description": "AryaCode Polish: one install for the small things that make AryaCode feel finished. One Plugins row, one switch per quality-of-life feature.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "polish",
    "quality-of-life",
    "spellcheck"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnectSuite/dsh-aryacode-polish.git"
  },
  "homepage": "https://github.com/KonnectSuite/dsh-aryacode-polish#readme",
  "bugs": {
    "url": "https://github.com/KonnectSuite/dsh-aryacode-polish/issues"
  },
  "files": [
    "cordis.patch.yml",
    "entries/**/*",
    "lib/**/*",
    "locale/*.json",
    "docs/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/patch.spec.mjs test/config.spec.mjs test/registry.spec.mjs test/docs.spec.mjs test/manifests.spec.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "js-yaml": "^4.1.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./polish": "./entries/polish.js"
  }
}
